# LLM provider — used by the router, sql_gen, a2ui_schema, and suggestions services
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# Comma-separated list of allowed CORS origins.
# Add your deployed Vercel frontend URL here alongside localhost.
# Example: CORS_ORIGINS=https://helix.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Base directory for all on-disk state (DuckDB + SQLite files).
# In Railway: set this to the mount path of your persistent volume (e.g. /data).
# Locally: leave unset — defaults to ./db inside the project.
DATA_DIR=./db
